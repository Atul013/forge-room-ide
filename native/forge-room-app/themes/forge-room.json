{
 "$schema": "vscode://schema/color-theme",
 "name": "Forge Room",
 "type": "dark",
 "colors": {
  "focusBorder": "#F04440",
  "foreground": "#F5F5F6",
  "descriptionForeground": "#B8BCC0",
  "disabledForeground": "#6B6D72",
  "errorForeground": "#E0766F",
  "editor.background": "#0D0F10",
  "editor.foreground": "#EFEFEE",
  "editorLineNumber.foreground": "#5E6065",
  "editorLineNumber.activeForeground": "#EFEFEE",
  "editor.selectionBackground": "#C74C4538",
  "editor.lineHighlightBackground": "#20171A",
  "sideBar.background": "#0C0D0E",
  "sideBar.foreground": "#D9D9D7",
  "activityBar.background": "#0B0D0E",
  "activityBar.foreground": "#EFEFEE",
  "activityBar.inactiveForeground": "#7A7C81",
  "activityBarBadge.background": "#E23635",
  "activityBarBadge.foreground": "#FFFFFF",
  "statusBar.background": "#0D0F10",
  "statusBar.foreground": "#A0A1A5",
  "titleBar.activeBackground": "#0D0F10",
  "titleBar.activeForeground": "#EFEFEE",
  "panel.background": "#0D0F10",
  "panel.border": "#25282A",
  "tab.inactiveBackground": "#0D0F10",
  "tab.border": "#25282A",
  "button.background": "#E23635",
  "button.foreground": "#FFFFFF",
  "input.background": "#0B0C0D",
  "input.border": "#2A2C2E",
  "list.activeSelectionBackground": "#212324",
  "list.hoverBackground": "#FFFFFF0B"
 },
 "tokenColors": [
  {
   "scope": [
    "comment"
   ],
   "settings": {
    "foreground": "#6F7176",
    "fontStyle": "italic"
   }
  },
  {
   "scope": [
    "keyword",
    "storage"
   ],
   "settings": {
    "foreground": "#E0766F"
   }
  },
  {
   "scope": [
    "string"
   ],
   "settings": {
    "foreground": "#D3BE92"
   }
  },
  {
   "scope": [
    "constant.numeric",
    "constant.language"
   ],
   "settings": {
    "foreground": "#E7A86F"
   }
  },
  {
   "scope": [
    "entity.name.function",
    "support.function"
   ],
   "settings": {
    "foreground": "#8DBBCB"
   }
  },
  {
   "scope": [
    "entity.name.type",
    "entity.name.class",
    "support.type"
   ],
   "settings": {
    "foreground": "#E5C78F"
   }
  },
  {
   "scope": [
    "variable"
   ],
   "settings": {
    "foreground": "#E4E4E2"
   }
  }
 ]
}