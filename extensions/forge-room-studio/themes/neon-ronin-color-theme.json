{
	"$schema": "vscode://schemas/color-theme",
	"name": "Forge Room · Neon Ronin",
	"type": "dark",
	"colors": {
		"focusBorder": "#e9a06a",
		"foreground": "#e8ddd8",
		"descriptionForeground": "#a99b9b",
		"disabledForeground": "#736a6c",
		"errorForeground": "#ff766d",
		"textLink.foreground": "#e9a06a",
		"textLink.activeForeground": "#ffc391",
		"editor.background": "#17171d",
		"editor.foreground": "#e8ddd8",
		"editorLineNumber.foreground": "#858585",
		"editorLineNumber.activeForeground": "#dfd4d1",
		"editorCursor.foreground": "#f2aa76",
		"editor.selectionBackground": "#77394388",
		"editor.inactiveSelectionBackground": "#49404a88",
		"editor.lineHighlightBackground": "#ffffff07",
		"editorIndentGuide.background1": "#35313b",
		"editorIndentGuide.activeBackground1": "#75606a",
		"editorWhitespace.foreground": "#38343d",
		"editorGutter.background": "#17171d",
		"editorError.foreground": "#ff766d",
		"editorWarning.foreground": "#e9ad69",
		"editorInfo.foreground": "#82b8c4",
		"sideBar.background": "#1d1b22",
		"sideBar.foreground": "#d8cccf",
		"sideBarTitle.foreground": "#eee3e1",
		"sideBarSectionHeader.background": "#24212a",
		"sideBarSectionHeader.foreground": "#c5b4b7",
		"activityBar.background": "#211b22",
		"activityBar.foreground": "#f0b185",
		"activityBar.inactiveForeground": "#8e7d84",
		"activityBarBadge.background": "#b84e59",
		"activityBarBadge.foreground": "#FFFFFF",
		"statusBar.background": "#57303d",
		"statusBar.foreground": "#f7e7dd",
		"statusBar.noFolderBackground": "#3c3039",
		"titleBar.activeBackground": "#211b22",
		"titleBar.activeForeground": "#eee3e1",
		"titleBar.inactiveBackground": "#1d1b22",
		"titleBar.inactiveForeground": "#a99b9b",
		"panel.background": "#19181e",
		"panel.border": "#36313b",
		"panelTitle.activeBorder": "#d57973",
		"tab.activeBackground": "#17171d",
		"tab.activeForeground": "#f0e4e1",
		"tab.inactiveBackground": "#211f26",
		"tab.inactiveForeground": "#a79ca1",
		"tab.border": "#312d35",
		"editorGroupHeader.tabsBackground": "#211f26",
		"editorGroup.border": "#35303a",
		"button.background": "#a64f59",
		"button.foreground": "#fff0e9",
		"button.hoverBackground": "#bd6068",
		"input.background": "#211f26",
		"input.foreground": "#eee3e1",
		"input.border": "#49414b",
		"list.activeSelectionBackground": "#5a3545",
		"list.activeSelectionForeground": "#fff0e9",
		"list.hoverBackground": "#ffffff0c",
		"badge.background": "#6e3d4d",
		"badge.foreground": "#fff0e9",
		"terminal.background": "#17171d",
		"terminal.foreground": "#ddd3d4",
		"terminal.ansiRed": "#d66b73",
		"terminal.ansiGreen": "#9aba8d",
		"terminal.ansiYellow": "#e6b16f",
		"terminal.ansiBlue": "#88a8d0",
		"terminal.ansiMagenta": "#c795c4",
		"terminal.ansiCyan": "#79b5bd",
		"diffEditor.insertedTextBackground": "#7da56d38",
		"diffEditor.removedTextBackground": "#c4555b38"
	},
	"tokenColors": [
		{ "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#89848e", "fontStyle": "italic" } },
		{ "scope": ["keyword", "storage", "storage.type"], "settings": { "foreground": "#d78bb2" } },
		{ "scope": ["string", "punctuation.definition.string"], "settings": { "foreground": "#b7c58a" } },
		{ "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#e6b16f" } },
		{ "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#84bbc2" } },
		{ "scope": ["entity.name.type", "entity.name.class", "support.type"], "settings": { "foreground": "#e0a180" } },
		{ "scope": ["variable", "meta.definition.variable"], "settings": { "foreground": "#e4d9d8" } },
		{ "scope": ["entity.name.tag"], "settings": { "foreground": "#d58eaa" } },
		{ "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#d9b68a" } }
	]
}
