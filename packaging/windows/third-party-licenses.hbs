<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Forge Room Early Preview — third-party licenses</title>
  <style>
    body { max-width: 72rem; margin: 2rem auto; padding: 0 1.25rem; color: #252525; font: 16px/1.5 system-ui, sans-serif; }
    h1, h2 { line-height: 1.2; }
    section { border-top: 1px solid #ccc; margin-top: 2rem; padding-top: 1rem; }
    pre { background: #f5f5f5; border: 1px solid #ddd; overflow-wrap: anywhere; padding: 1rem; white-space: pre-wrap; }
  </style>
</head>
<body>
  <h1>Forge Room Early Preview — third-party licenses</h1>
  <p>Generated from the locked Windows x64 Cargo dependency graph by cargo-about.</p>
  {{#each licenses}}
  <section id="{{id}}">
    <h2>{{name}}</h2>
    <p>Used by:</p>
    <ul>
      {{#each used_by}}
      <li>{{crate.name}} {{crate.version}}</li>
      {{/each}}
    </ul>
    <pre>{{text}}</pre>
  </section>
  {{/each}}
</body>
</html>

